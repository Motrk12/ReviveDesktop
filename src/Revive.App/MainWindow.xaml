<Window x:Class="Revive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Revive.App.Views"
        xmlns:vm="clr-namespace:Revive.App.ViewModels"
        Title="Revive · Recover deleted files" Icon="/Assets/Revive.ico"
        Width="1240" Height="800" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <views:HomeView>
            <views:HomeView.Style>
                <Style TargetType="views:HomeView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowResults}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:HomeView.Style>
        </views:HomeView>
        <views:ResultsView Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" />

        <!-- Recovery in progress -->
        <Grid Background="#80111827" Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="28,24" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Recovering your files…" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding RecoveryText}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,14" />
                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding RecoveryProgress, Mode=OneWay}" Maximum="100" />
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelRecoveryCommand}" Content="Cancel" HorizontalAlignment="Right" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
