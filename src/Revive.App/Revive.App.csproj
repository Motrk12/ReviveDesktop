<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Revive</AssemblyName>
    <RootNamespace>Revive.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Revive.ico</ApplicationIcon>
    <Product>Revive</Product>
    <Description>Recover deleted photos, videos and files</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Revive.Core\Revive.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Revive.ico" />
  </ItemGroup>

</Project>
